{
  "manifest_version": 3,
  "name": "Image Converter & Compressor: PNG, JPG, WebP",
  "short_name": "Image Converter",
  "version": "1.2.0",
  "description": "Shrink photos under 100 KB for forms, or convert PNG, JPG and WebP. Free, offline, and nothing is ever uploaded.",
  "minimum_chrome_version": "110",
  "permissions": [
    "contextMenus",
    "downloads",
    "storage",
    "notifications"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Image Converter",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}